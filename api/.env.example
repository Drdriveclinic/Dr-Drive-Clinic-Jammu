PORT=5000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=drive_clinic
DB_USER=root
DB_PASS=
CORS_ORIGIN=*

# GoDaddy Business Email SMTP Configuration
# Primary inbox: care@thedriveclinic.com
# For GoDaddy Microsoft 365, use: SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_SECURE=false
# For standard GoDaddy cPanel / Workspace, use: SMTP_HOST=smtpout.secureserver.net, SMTP_PORT=465, SMTP_SECURE=true
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=Care@thedriveclinic.com
SMTP_PASS=your_godaddy_email_password_here
NOTIFICATION_EMAIL=Care@thedriveclinic.com, thedriveclinic@gmail.com
NOTIFICATION_FROM="The Drive Clinic" <Care@thedriveclinic.com>
